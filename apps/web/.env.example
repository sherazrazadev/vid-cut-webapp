# vid-cut — free / local MVP (no Docker, no paid services required)
# Copy to .env.local:
#   cp apps/web/.env.example apps/web/.env.local

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth off by default (guest editor). Set true + DATABASE_URL + BETTER_AUTH_SECRET to enable.
AUTH_ENABLED=false

# Optional: Postgres (only if AUTH_ENABLED=true or you want feedback persistence)
# DATABASE_URL=postgresql://opencut:opencut@localhost:5432/opencut
# BETTER_AUTH_SECRET=

# Optional: Redis rate limits (Upstash or local serverless-redis-http)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Freesound stock audio search
# FREESOUND_CLIENT_ID=
# FREESOUND_API_KEY=

# Optional: Marble CMS blog
# NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
# MARBLE_WORKSPACE_KEY=

# Optional: third-party analytics (off by default)
# NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional: GitHub repo for contributors page (owner/name)
# NEXT_PUBLIC_GITHUB_REPO=
